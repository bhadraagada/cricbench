# Example environment variables for CricBench
# Copy this file to `.env` and fill in your own values.

# Required: OpenRouter API key for running all benchmark models
# Sign up and get a key from https://openrouter.ai
OPENROUTER_API_KEY=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

# Optional: override the default OpenRouter API base URL
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: control how many times each model is run per test case
# If unset, CricBench defaults to 30
# CRICKET_BENCH_RUNS=10
